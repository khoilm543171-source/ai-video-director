# ============================================================
# LLM ROUTING
# ============================================================
# Default provider for all text agents: vilao | deepseek | generic
LLM_PROVIDER=vilao

# Optional fallback provider. Leave blank to disable fallback.
LLM_FALLBACK_PROVIDER=

# Retry only temporary provider/upstream failures.
# 3 means at most 3 total attempts for the same provider request.
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=1.5

# ----------------------------
# Vilao (OpenAI-compatible)
# ----------------------------
# The API example provided by Vilao uses:
# POST https://api.vilao.ai/v1/chat/completions
VILAO_BASE_URL=https://api.vilao.ai/v1
VILAO_API_KEY=

# IMPORTANT: copy the exact model ID from your Vilao Marketplace/API example.
# Examples may differ by provider/route, so do not guess the DeepSeek slug.
VILAO_MODEL=

# Optional fallback model IDs using the SAME Vilao API key.
# Comma-separated, tried left-to-right only after the primary model fails.
# Example:
# VILAO_FALLBACK_MODELS=cheap-route-2,stable-route-3
VILAO_FALLBACK_MODELS=

# ----------------------------
# DeepSeek direct fallback
# ----------------------------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# ----------------------------
# Optional per-agent routing
# ----------------------------
# If unset, each stage inherits LLM_PROVIDER.
# IDEA_LLM_PROVIDER=vilao
# STORY_LLM_PROVIDER=vilao
# SCRIPT_LLM_PROVIDER=vilao
# STORYBOARD_LLM_PROVIDER=vilao
# VEO_PROMPT_BUILDER_LLM_PROVIDER=vilao
# AUDIO_DIRECTOR_LLM_PROVIDER=vilao

# ----------------------------
# Generic OpenAI-compatible provider
# ----------------------------
# Use only when LLM_PROVIDER=generic or a stage override is generic.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ============================================================
# AUDIO SERVICES
# ============================================================
CHATTERBOX_DEVICE=cuda
CHATTERBOX_NANO=false
AUDIO_OUTPUT_ROOT=outputs/audio

MMAUDIO_ROOT=vendor/mmaudio
# MMAUDIO_PYTHON=C:\path\to\mmaudio-env\python.exe

ACESTEP_URL=http://127.0.0.1:8001
ACESTEP_API_KEY=

# ============================================================
# TOKEN ECONOMY
# ============================================================
LLM_CACHE=true
LLM_CACHE_DIR=.cache/llm
LLM_PROMPT_TOKEN_BUDGET=6000
LLM_USAGE_LOG=outputs/token_usage.jsonl