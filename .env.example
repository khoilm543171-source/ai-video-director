# Core LLM - OpenAI compatible
# DeepSeek example:
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Or keep your existing DeepSeek variable:
DEEPSEEK_API_KEY=

# Audio services
CHATTERBOX_DEVICE=cuda
CHATTERBOX_NANO=false
AUDIO_OUTPUT_ROOT=outputs/audio

MMAUDIO_ROOT=vendor/mmaudio
# MMAUDIO_PYTHON=C:\\path\\to\\mmaudio-env\\python.exe

ACESTEP_URL=http://127.0.0.1:8001
ACESTEP_API_KEY=

# Token economy
# Cache identical agent requests locally. Re-running the same input can use 0 LLM tokens.
LLM_CACHE=true
LLM_CACHE_DIR=.cache/llm

# Soft guardrail for estimated input tokens per agent.
# If exceeded, the pipeline stops instead of silently sending a huge context window.
LLM_PROMPT_TOKEN_BUDGET=6000

# JSONL usage log. Provider token counts are recorded when returned by the API.
LLM_USAGE_LOG=outputs/token_usage.jsonl
